{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ahairu",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-27",
  "routes": [
    {
      "pattern": "araihu.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
