package site

import (
	"fmt"

	landingshell "github.com/araihu/goshtoso-app-shells/landingshell"
	shellassets "github.com/araihu/goshtoso-app-shells/landingshell/assets"
	"github.com/araihu/goshtoso/components/card"
	"github.com/araihu/goshtoso/components/head"
)

templ HomePage(page Page) {
	if page.Home != nil {
		@HomeDocument(page, *page.Home)
	}
}

templ HomeDocument(page Page, content Content) {
	<!doctype html>
	<html lang={ content.Language } data-theme="araihu" data-theme-source="default">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ page.Meta.Title }</title>
			@Metadata(page)
			@head.Dependencies(head.WithStylesheetURL("/assets/styles.css"), head.WithLocalRuntime())
			<link rel="stylesheet" href={ shellassets.StylesheetURL("/landingshell/assets/") }/>
			<link rel="stylesheet" href="/assets/araihu-theme.css"/>
			<link rel="stylesheet" href="/assets/ahairu.css"/>
			<script defer src="/assets/js/storm-backdrop.js?rev=3"></script>
			<script defer src="/assets/js/x9-availability.js?rev=1"></script>
			<script src="/assets/campaign/v1.js" data-channel="/assets/releases/current" defer integrity="sha384-oPH7l1vK9vKP1Dn+18sO3yEXlz4ts6KzPEQl0SW4Y/+im05gOaamNNaQAf6bGH/n" crossorigin="anonymous"></script>
			<script>
				document.addEventListener("htmx:beforeRequest", (event) => {
					const element = event.detail?.elt;
					if (!(element instanceof Element) || !element.matches("[data-chart-bundle-trigger]")) return;
					if (document.documentElement.dataset.chartBundleRequested === "true") {
						event.preventDefault();
						return;
					}
					document.documentElement.dataset.chartBundleRequested = "true";
				});
				document.addEventListener("htmx:afterRequest", (event) => {
					const element = event.detail?.elt;
					if (element instanceof Element && element.matches("[data-chart-bundle-trigger]") && !event.detail.successful) {
						delete document.documentElement.dataset.chartBundleRequested;
					}
				});
			</script>
		</head>
		<body class="ahairu-archive min-h-screen selection:bg-primary selection:text-on-primary">
			<a class="skip-link" href="#main-content">{ content.SkipLabel }</a>
			<header class="ahairu-header">
				<nav class="ahairu-nav py-5 md:py-7" aria-label={ content.PrimaryNavigationLabel }>
					<a class="ahairu-brand" href={ content.Path }>
						<img src={ araihuIconURL } alt="" width="64" height="64"/>
						<span class="ahairu-brand-copy"><strong>{ content.Name }</strong><small>{ content.Tagline }</small></span>
					</a>
					<ul class="ahairu-primary-links">
						<li><a href="#home">{ content.NavHome }</a></li>
						<li><a href="#libs">{ content.NavLibs }</a></li>
						<li><a href="#apps">{ content.NavApps }</a></li>
						<li><a href="#field-notes">{ content.NavBlog } <span>{ content.WorkInProgress }</span></a></li>
					</ul>
					<div class="ahairu-nav-tools">
						<a class="ahairu-github" href="https://github.com/araihu">GitHub ↗</a>
						<div class="ahairu-locale flex gap-3 text-sm font-semibold">
							@LocaleLinks(content)
						</div>
						<button class="ahairu-campaign-toggle" type="button" hidden data-campaign-toggle aria-pressed="false">
							<span data-campaign-toggle-icon aria-hidden="true"></span>
							<span class="sr-only">Use the standard Arai Hû appearance</span>
						</button>
					</div>
				</nav>
			</header>
			@landingshell.MobileNavigation(landingshell.MobileNavigationConfig{
				ID:              "araihu-navigation",
				Title:           content.PrimaryNavigationLabel,
				TriggerLabel:    content.MenuLabel,
				NavigationLabel: content.PrimaryNavigationLabel,
				Position:        landingshell.FloatingBottomLeft,
				RootClass:       "storm-mobile-menu",
				TriggerClass:    "storm-mobile-trigger",
				PanelClass:      "storm-mobile-panel",
			}, MobileMenuContent(content))
			<main id="main-content" tabindex="-1">
				<section id="home" class="storm-hero" aria-labelledby="hero-title">
					<div class="storm-video-stage" aria-hidden="true">
						<video class="storm-backdrop" data-storm-backdrop loop muted playsinline preload="none">
							<source media="(prefers-color-scheme: light)" src="/assets/video/storm-light-v2.mp4" type="video/mp4"/>
							<source media="(prefers-color-scheme: dark)" src="/assets/video/storm-dark-v2.mp4" type="video/mp4"/>
							<source src="/assets/video/storm-dark-v2.mp4" type="video/mp4"/>
						</video>
						<div class="storm-video-filter"></div>
					</div>
					<div class="storm-copy ahairu-shell mx-auto px-6 md:px-10">
						<p class="storm-kicker">{ content.OpenSourceLabel } · Arai Hû</p>
						<h1 id="hero-title" class="storm-title">{ content.Tagline }</h1>
						<p class="storm-intro mt-8">{ content.Intro }</p>
					</div>
				</section>
				<section id="libs" class="featured-project" aria-labelledby="featured-title">
					<div class="ahairu-shell featured-project-inner mx-auto px-6 md:px-10">
						<div class="featured-copy">
							<p class="storm-kicker">02 — { content.FeaturedLabel }</p>
							<h2 id="featured-title">{ content.FeaturedTitle }</h2>
							<p>{ content.FeaturedDescription }</p>
						</div>
						<div class="featured-family-grid" role="group" aria-label={ content.FeaturedFamilyLabel }>
							@FeaturedFamilyCard(content, content.Projects[0], "goshtoso")
							@FeaturedFamilyCard(content, content.MoreProjects[0], "shells")
							@FeaturedFamilyCard(content, content.MoreProjects[1], "charts")
						</div>
					</div>
				</section>
				<section class="project-showcase" aria-labelledby="projects-title">
					<div id="chart-lazy-stage" hidden></div>
					<div class="ahairu-shell mx-auto px-6 md:px-10">
						<div class="showcase-heading">
							<div>
								<p class="showcase-kicker">03 — { content.ProjectsKicker }</p>
								<h2 id="projects-title">{ content.ProjectsLabel }</h2>
							</div>
							<p>{ content.ProjectsIntro }</p>
						</div>
						<div id="apps" class="project-collection">
							<h3><span>02</span>{ content.AppsLabel }</h3>
							<ol class="project-grid mt-8">
								for index, project := range content.Projects[1:] {
									@ProjectTile(content, project, index + 1)
								}
							</ol>
						</div>
					</div>
				</section>
				<section class="more-projects" aria-labelledby="more-title">
					<div class="ahairu-shell mx-auto px-6 md:px-10">
						<div class="more-heading">
							<p class="showcase-kicker">04 — { content.MoreLabel }</p>
							<h2 id="more-title">{ content.MoreLabel }</h2>
							<p>{ content.MoreIntro }</p>
						</div>
						<ol class="more-list">
							for index, project := range content.MoreProjects[2:] {
								<li>
									<article class="more-row">
										<span class="more-index">{ fmt.Sprintf("%02d", index + 1) }</span>
										@MoreProjectArt(content, project)
										<div class="more-copy"><p>{ project.Category } @ProjectBadges(project)</p><h3><a class="more-project-link" href={ project.URL } aria-label={ project.Name + " — " + project.Description }>{ project.Name }</a></h3><p>{ project.Description }</p></div>
										<span class="more-arrow" aria-hidden="true">↗</span>
									</article>
								</li>
							}
						</ol>
					</div>
				</section>
				<section class="open-mission" aria-labelledby="mission-title">
					<div class="ahairu-shell mx-auto px-6 md:px-10">
						<p class="storm-kicker">05 — { content.OpenSourceLabel }</p>
						<h2 id="mission-title">{ content.MissionTitle }</h2>
						<p>{ content.MissionCopy }</p>
					</div>
				</section>
				<section class="keep-up" aria-label={ content.NavBlog }>
					<div class="ahairu-shell keep-up-grid mx-auto px-6 md:px-10">
						<div id="field-notes" class="mailing-panel">
							<p class="panel-status">{ content.NavBlog } · { content.WorkInProgress }</p>
							<h2>{ content.MailingTitle }</h2>
							<p>{ content.MailingCopy }</p>
							<form class="mailing-preview" aria-label={ content.MailingTitle }>
								<label class="sr-only" for="mailing-email">Email</label>
								<input id="mailing-email" type="email" placeholder={ content.MailingPlaceholder } disabled/>
								<button type="button" disabled>{ content.MailingAction }</button>
							</form>
						</div>
						<div class="chat-panel">
							<p class="panel-status">GitHub · { content.OpenSourceLabel }</p>
							<h2>{ content.ChatTitle }</h2>
							<p>{ content.ChatCopy }</p>
							<a href="https://github.com/araihu">{ content.ChatAction } <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</section>
			</main>
			<footer class="ahairu-shell ahairu-footer mx-auto flex flex-col gap-3 px-6 py-6 text-sm md:flex-row md:items-center md:justify-between md:px-10 md:py-8">
				<div>
					<p>© 2026 { content.Name }.</p>
					<p>{ content.FooterBuiltWith } <a href="https://go.dev/">Go</a> { content.FooterConjunction } <a href="https://goshtoso.araihu.com">Goshtoso</a>.</p>
				</div>
				<p>{ content.Meaning }</p>
				<nav class="ahairu-footer-links" aria-label="Arai Hû"><a href={ templ.SafeURL(pathFor(PageBrand, page.Meta.Locale.Language)) }>Brand</a><a href={ templ.SafeURL(pathFor(PageLicense, page.Meta.Locale.Language)) }>License</a></nav>
			</footer>
		</body>
	</html>
}

templ LocaleLinks(content Content) {
	if content.Path == "/pt-br/" {
		<a href="/pt-br/" aria-current="page">PT</a>
	} else {
		<a href="/pt-br/">PT</a>
	}
	if content.Path == "/en/" {
		<a href="/en/" aria-current="page">EN</a>
	} else {
		<a href="/en/">EN</a>
	}
	if content.Path == "/es/" {
		<a href="/es/" aria-current="page">ES</a>
	} else {
		<a href="/es/">ES</a>
	}
}

templ MobileMenuContent(content Content) {
	<a class="mobile-menu-brand" href={ content.Path }><strong>{ content.Name }</strong><small>{ content.Tagline }</small></a>
	<ul class="mobile-menu-list">
		<li><a href="#home">{ content.NavHome }</a></li>
		<li><a href="#libs">{ content.NavLibs }</a></li>
		<li><a href="#apps">{ content.NavApps }</a></li>
		<li><a href="#field-notes">{ content.NavBlog } <span>{ content.WorkInProgress }</span></a></li>
	</ul>
	<div class="mobile-menu-tools">
		<a href="https://github.com/araihu">GitHub ↗</a>
		@LocaleLinks(content)
	</div>
}

templ ProjectTile(content Content, project Project, index int) {
	<li class={ fmt.Sprintf("project-tile project-tile--%d", index + 1) }>
		<a class="project-card" href={ project.URL } aria-label={ content.ProjectAction + ": " + project.Name }>
			@card.Card(card.Config{
				Media:       ProjectMedia(content, project),
				MediaClass:  "project-media",
				Tag:         fmt.Sprintf("%02d — %s", index + 1, project.Category),
				Title:       project.Name,
				Description: project.Description,
				Footer:      ProjectFooter(content, project),
				Interaction: card.InteractionPressed,
				RootClass:   "project-card-surface",
			})
		</a>
	</li>
}

templ ProjectMedia(content Content, project Project) {
	if project.Name == "Manja" {
		<div class="project-art project-art--openapi" aria-hidden="true">
			<div class="openapi-toolbar"><i></i><i></i><i></i><span>github-rest-api.yaml</span></div>
			<div class="openapi-viewport">
				<div class="openapi-stream">
					<div class="openapi-block">@OpenAPILines()</div>
					<div class="openapi-block">@OpenAPILines()</div>
				</div>
			</div>
		</div>
	} else if project.Name == "Pajé" {
		<div id="paje-chart-slot" class="project-art project-art--graph chart-placeholder" data-chart-placeholder="paje" aria-busy="true">
			@ChartBundleTrigger(content)
			<span class="chart-placeholder-pulse" aria-hidden="true"></span>
		</div>
	} else if project.Name == "X-9" {
		<div id="x9-chart-slot" class="project-art project-art--monitor chart-placeholder" data-chart-placeholder="x9" aria-busy="true">
			@ChartBundleTrigger(content)
			<span class="chart-placeholder-pulse" aria-hidden="true"></span>
		</div>
	} else {
		<div class="project-art" aria-hidden="true">
			<span class="project-art-name">{ project.Name }</span>
			if project.MarkURL != "" {
				<img class="project-mark" src={ project.MarkURL } alt="" width="160" height="160" decoding="async"/>
			} else {
				<span class="project-mark project-mark--word">{ project.MarkText }</span>
			}
		</div>
	}
}

templ FeaturedFamilyCard(content Content, project Project, kind string) {
	<a class={ "featured-family-card featured-family-card--" + kind } href={ project.URL } aria-label={ content.ProjectAction + ": " + project.Name }>
		@card.Card(card.Config{
			Media:       FeaturedFamilyMedia(content, project),
			MediaClass:  "featured-family-media",
			Tag:         project.Category,
			Title:       project.Name,
			Description: project.Description,
			Footer:      FeaturedFamilyFooter(content, project),
			Interaction: card.InteractionPressed,
			RootClass:   "featured-family-card-surface",
		})
	</a>
}

templ FeaturedFamilyMedia(content Content, project Project) {
	if project.Name == "Goshtoso" {
		<figure class="featured-demo">
			<img class="featured-brand-mark" src={ project.MarkURL } alt="" width="56" height="56" decoding="async"/>
			<video data-featured-montage loop muted playsinline preload="none" poster="/assets/visuals/goshtoso-components-poster-v2.webp">
				<source src="/assets/visuals/goshtoso-components-montage-v2-av1.mp4" type='video/mp4; codecs="av01.0.05M.08"'/>
				<source src="/assets/visuals/goshtoso-components-montage-v2.mp4" type="video/mp4"/>
			</video>
			<figcaption><span>Tabs · HTMX · Monitoring · Line 3D</span></figcaption>
		</figure>
	} else {
		@MoreProjectArt(content, project)
	}
}

templ FeaturedFamilyFooter(content Content, project Project) {
	<span class="featured-family-badges">@ProjectBadges(project)</span>
	<span class="featured-family-action">{ content.ProjectAction } <span aria-hidden="true">↗</span></span>
}

templ OpenAPILines() {
	for _, line := range GitHubReleaseOpenAPILines() {
		<span>{ line.Indent }<b>{ line.Key }</b>{ line.Value }</span>
	}
}

templ MoreProjectArt(content Content, project Project) {
	if project.Name == "Goshtoso Charts" {
		<div id="goshtoso-heart-chart-slot" class="more-art more-art--chart chart-placeholder" data-chart-placeholder="goshtoso-heart" aria-busy="true">
			@ChartBundleTrigger(content)
			<span class="chart-placeholder-pulse" aria-hidden="true"></span>
		</div>
	} else if project.Name == "Muamba" {
		<div class="more-art more-art--muamba" aria-hidden="true">
			<b class="muamba-name">Muamba</b>
			<div class="muamba-drops">
				<img class="muamba-drop" src="/assets/visuals/muamba-mark.svg" alt="" width="64" height="64" decoding="async"/>
				<img class="muamba-drop" src="/assets/visuals/muamba-mark.svg" alt="" width="64" height="64" decoding="async"/>
				<img class="muamba-drop" src="/assets/visuals/muamba-mark.svg" alt="" width="64" height="64" decoding="async"/>
				<img class="muamba-drop" src="/assets/visuals/muamba-mark.svg" alt="" width="64" height="64" decoding="async"/>
				<img class="muamba-drop" src="/assets/visuals/muamba-mark.svg" alt="" width="64" height="64" decoding="async"/>
				<img class="muamba-drop" src="/assets/visuals/muamba-mark.svg" alt="" width="64" height="64" decoding="async"/>
			</div>
		</div>
	} else if project.Name == "Goshtoso App Shells" {
		<div class="more-art more-art--shells" data-shell-preview aria-hidden="true">
			<div class="shell-preview shell-preview--desktop">
				<div class="shell-preview-topbar"><i></i><i></i><i></i></div>
				<div class="shell-preview-body"><aside><i></i><i></i><i></i></aside><main><b></b><span></span><span></span></main></div>
			</div>
			<div class="shell-preview shell-preview--mobile">
				<div class="shell-preview-topbar"><i></i><b></b></div>
				<div class="shell-preview-body"><aside><i></i><i></i><i></i></aside><main><span></span><span></span></main></div>
			</div>
		</div>
	} else {
		<div class="more-art" aria-hidden="true"><span>{ project.Name }</span></div>
	}
}

templ ChartBundleTrigger(content Content) {
	<span
		class="chart-bundle-trigger"
		data-chart-bundle-trigger
		aria-hidden="true"
		hx-get={ ChartFragmentURL(content) }
		hx-trigger="revealed once"
		hx-target="#chart-lazy-stage"
		hx-swap="innerHTML"
		hx-sync="#chart-lazy-stage:drop"
	></span>
}


templ ProjectStatus(project Project) {
	if project.Status != "" {
		<span class="project-status" data-status={ project.Status }>{ project.Status }</span>
	}
}

templ ProjectBadges(project Project) {
	@ProjectStatus(project)
	@ProjectVersion(project)
}

templ ProjectVersion(project Project) {
	if project.Name == "Goshtoso" {
		<span
			id="goshtoso-version-slot"
			class="project-version"
			aria-live="polite"
			hx-get="/api/project-versions"
			hx-trigger="load delay:750ms"
			hx-swap="outerHTML"
		></span>
	} else if project.Name == "Goshtoso App Shells" {
		<span id="goshtoso-app-shells-version-slot" class="project-version" aria-live="polite"></span>
	} else if project.Name == "Goshtoso Charts" {
		<span id="goshtoso-charts-version-slot" class="project-version" aria-live="polite"></span>
	}
}

templ ProjectFooter(content Content, project Project) {
	if project.MarkURL != "" {
		<img class="project-title-mark" src={ project.MarkURL } alt="" width="44" height="44" decoding="async"/>
	}
	@ProjectStatus(project)
	<span class="project-action">{ content.ProjectAction } <span aria-hidden="true">↗</span></span>
}
