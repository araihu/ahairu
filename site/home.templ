package site

import (
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/card"
)

templ Page() {
	<!doctype html>
	<html lang="en" data-theme="goshtoso">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="AraiHu builds considered Go software."/>
			<title>AraiHu — Durable software, clearly made</title>
			<link rel="stylesheet" href="/assets/styles.css"/>
		</head>
		<body class="min-h-screen bg-surface text-on-surface selection:bg-primary selection:text-on-primary">
			<main class="mx-auto flex min-h-screen max-w-6xl flex-col px-6 py-6 md:px-10 md:py-10">
				<nav class="flex items-center justify-between" aria-label="Primary navigation">
					<a class="text-lg font-black tracking-tight text-on-surface-strong no-underline" href="/">AraiHu</a>
					<a class="text-sm font-semibold text-on-surface underline decoration-primary underline-offset-4" href="mailto:hello@araihu.dev">Start a conversation</a>
				</nav>
				<section class="grid flex-1 items-center gap-12 py-20 lg:grid-cols-[1.25fr_.75fr] lg:py-28" aria-labelledby="hero-title">
					<div class="max-w-3xl">
						@badge.Badge(badge.Config{Label: "Independent software studio", Tone: badge.TonePrimary, Appearance: badge.AppearanceSoft, Indicator: true})
						<h1 id="hero-title" class="mt-6 text-balance text-5xl font-black leading-[.95] tracking-[-.055em] text-on-surface-strong md:text-7xl">Durable software,<br/>clearly made.</h1>
						<p class="mt-7 max-w-xl text-pretty text-lg leading-8 text-on-surface md:text-xl">AraiHu makes calm, useful systems for people doing real work. Go-native foundations, thoughtful interfaces, and operations that stay understandable.</p>
						<div class="mt-9 flex flex-wrap gap-3">
							@button.Button(button.WithTone(button.TonePrimary), button.WithRootClass("pointer-events-none")) { Explore the work }
							<a class="inline-flex items-center justify-center rounded-radius border border-outline px-4 py-2.5 text-sm font-semibold text-on-surface no-underline" href="mailto:hello@araihu.dev">Build together</a>
						</div>
					</div>
					<div class="relative">
						<div class="absolute -inset-5 rounded-full bg-primary/10 blur-3xl"></div>
						@card.Card(card.Config{Tag: "Principle", Title: "Make the useful thing last.", Description: "Small seams. Clear ownership. Systems that work under pressure and remain pleasant to change.", Appearance: card.AppearancePrimary, RootClass: "relative max-w-none shadow-xl shadow-primary/10"})
					</div>
				</section>
				<footer class="flex flex-col gap-3 border-t border-outline pt-6 text-sm text-on-surface md:flex-row md:items-center md:justify-between">
					<p>© 2026 AraiHu. Built with Go and Goshtoso.</p>
					<p>Static by design.</p>
				</footer>
			</main>
		</body>
	</html>
}
