package site

import "fmt"

templ Page(content Content) {
	<!doctype html>
	<html lang={ content.Language } data-theme="araihu">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ content.Intro }/>
			<meta name="theme-color" content="#f3f2e9"/>
			<title>{ content.Name } — { content.Tagline }</title>
			<link rel="icon" type="image/svg+xml" href="/assets/logos/araihu-icon-background.svg?rev=a8a9647a"/>
			<link rel="stylesheet" href="/assets/styles.css"/>
			<link rel="stylesheet" href="/assets/araihu-theme.css?rev=a8a9647a"/>
			<link rel="stylesheet" href="/assets/ahairu.css?rev=a8a9647a"/>
		</head>
		<body class="ahairu-archive min-h-screen selection:bg-primary selection:text-on-primary">
			<a class="skip-link" href="#main-content">{ content.SkipLabel }</a>
			<header class="ahairu-header">
				<nav class="ahairu-shell ahairu-nav mx-auto flex items-center justify-between px-6 py-5 md:px-10 md:py-7" aria-label={ content.PrimaryNavigationLabel }>
					<a class="ahairu-brand" href={ content.Path }>
						<img class="ahairu-brand-logo" src={ araihuLogoURL } alt={ content.Name } width="242" height="60"/>
					</a>
					<div class="ahairu-locale flex gap-3 text-sm font-semibold">
						if content.Path == "/pt-br/" {
							<a href="/pt-br/" aria-current="page">PT</a>
						} else {
							<a href="/pt-br/">PT</a>
						}
						if content.Path == "/en/" {
							<a href="/en/" aria-current="page">EN</a>
						} else {
							<a href="/en/">EN</a>
						}
						if content.Path == "/es/" {
							<a href="/es/" aria-current="page">ES</a>
						} else {
							<a href="/es/">ES</a>
						}
					</div>
				</nav>
			</header>
			<main id="main-content" class="ahairu-shell mx-auto px-6 md:px-10" tabindex="-1">
				<section class="storm-hero" aria-labelledby="hero-title">
					<h1 id="hero-title" class="storm-title">{ content.Tagline }</h1>
					<p class="storm-intro mt-8">{ content.Intro }</p>
				</section>
				<section class="project-ledger" aria-labelledby="projects-title">
					<h2 id="projects-title">{ content.ProjectsLabel }</h2>
					<ol class="project-list mt-8">
						for index, project := range content.Projects {
							<li>
								<a class="project-row" href={ project.URL }>
									<span class="project-index">{ fmt.Sprintf("%02d", index + 1) }</span>
									if project.MarkURL != "" {
										<img class="project-mark" src={ project.MarkURL } alt="" width="48" height="48" decoding="async"/>
									} else {
										<span class="project-mark project-mark--word" aria-hidden="true">{ project.MarkText }</span>
									}
									<h3 class="project-name">{ project.Name }</h3>
									<p class="project-description">{ project.Description }</p>
									<span class="project-arrow" aria-hidden="true">↗</span>
								</a>
							</li>
						}
					</ol>
				</section>
			</main>
			<footer class="ahairu-shell ahairu-footer mx-auto flex flex-col gap-3 px-6 py-6 text-sm md:flex-row md:items-center md:justify-between md:px-10 md:py-8">
				<div>
					<p>© 2026 { content.Name }.</p>
					<p>{ content.FooterBuild }</p>
				</div>
					<p>{ content.Meaning }</p>
			</footer>
		</body>
	</html>
}
