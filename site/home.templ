package site

import "fmt"

templ Page(content Content) {
	<!doctype html>
	<html lang={ content.Language } data-theme="goshtoso">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ content.Intro }/>
			<title>{ content.Name } — { content.Tagline }</title>
			<link rel="stylesheet" href="/assets/styles.css"/>
			<link rel="stylesheet" href="/assets/ahairu.css?rev=archive-v1"/>
		</head>
		<body class="ahairu-archive min-h-screen selection:bg-primary selection:text-on-primary">
			<main class="ahairu-shell mx-auto flex min-h-screen flex-col px-6 py-6 md:px-10 md:py-10">
				<nav class="ahairu-nav flex items-center justify-between pb-5" aria-label="Primary navigation">
					<a class="text-lg font-black tracking-tight text-on-surface-strong no-underline" href={ content.Path }>{ content.Name }</a>
					<div class="ahairu-locale flex gap-3 text-sm font-semibold"><a href="/pt-br/">PT</a><a href="/en/">EN</a><a href="/es/">ES</a></div>
				</nav>
				<section class="storm-hero" aria-labelledby="hero-title">
					<p class="storm-label">{ content.Meaning }</p>
					<h1 id="hero-title" class="storm-title mt-6">{ content.Tagline }</h1>
					<p class="storm-intro mt-8">{ content.Intro }</p>
				</section>
				<section class="project-ledger" aria-labelledby="projects-title">
					<h2 id="projects-title">{ content.ProjectsLabel }</h2>
					<div class="mt-8">
						for index, project := range content.Projects {
							<a class="project-row" href={ project.URL } target="_blank" rel="noopener noreferrer">
								<span class="project-index">{ fmt.Sprintf("%02d", index + 1) }</span>
								<h3 class="project-name">{ project.Name }</h3>
								<p class="project-description">{ project.Description }</p>
								<span class="project-arrow" aria-hidden="true">↗</span>
							</a>
						}
					</div>
				</section>
				<footer class="flex flex-col gap-3 border-t border-outline pt-6 text-sm text-on-surface md:flex-row md:items-center md:justify-between">
					<p>© 2026 { content.Name }. Built with Go and Goshtoso.</p>
					<p>{ content.Meaning }</p>
				</footer>
			</main>
		</body>
	</html>
}
